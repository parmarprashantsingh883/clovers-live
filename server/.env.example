# ── Server ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Dev: in-memory MongoDB + auto-seed from Backend/db.json (zero setup).
# Prod: set USE_MEMORY_DB=false and provide MONGO_URI (Atlas).
USE_MEMORY_DB=true
SEED_ON_BOOT=true
# MONGO_URI=

# ── Auth (REQUIRED in production: long random strings) ──
JWT_ACCESS_SECRET=dev-access-secret-change-me-in-prod
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-in-prod

# ── CORS / client origin(s), comma-separated ────────────
CLIENT_URL=http://localhost:5173,http://localhost:8080

# ── Payments (unset = mock gateway, full flow works locally)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
